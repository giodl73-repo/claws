{
  "slug": "upgrade-lkg-state-future-version",
  "description": "future-version state → LKG_STATE_FILE_VERSION_MISMATCH; recovery via delete+repromote",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{ \"version\": \"0.1.0\" }\n"
      },
      {
        "path": ".openclaw/lkg-health.json",
        "content": "{\n  \"version\": \"9.9.9\",\n  \"entries\": {}\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "status hits LKG_STATE_FILE_VERSION_MISMATCH (F-011 fixed)",
      "verb": "status",
      "expect": {
        "exitCode": 2,
        "errCode": "LKG_STATE_FILE_VERSION_MISMATCH"
      }
    },
    {
      "type": "edit-file",
      "name": "operator wipes the bad state file",
      "path": ".openclaw/lkg-health.json",
      "op": "delete"
    },
    {
      "type": "run-cage",
      "name": "fresh promote works after wipe",
      "verb": "promote",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "run-cage",
      "name": "subsequent status reports clean",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    }
  ]
}
