// Migrated from upgrade-lkg-state-no-version-field.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "upgrade-lkg-state-no-version-field",
  "description": "pre-versioning state file → LKG_STATE_FILE_VERSION_MISMATCH",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": ".openclaw/lkg-health.json",
        "content": "{\n  \"entries\": {\n    \"/some/legacy/path/AGENTS.md\": {\n      \"lastKnownGood\": { \"hash\": \"abc\", \"bytes\": 0, \"observedAt\": \"2025-01-01T00:00:00Z\" }\n    }\n  }\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "status hits LKG_STATE_FILE_VERSION_MISMATCH on no-version state",
      "verb": "status",
      "expect": {
        "exitCode": 2,
        "errCode": "LKG_STATE_FILE_VERSION_MISMATCH"
      }
    }
  ]
}
