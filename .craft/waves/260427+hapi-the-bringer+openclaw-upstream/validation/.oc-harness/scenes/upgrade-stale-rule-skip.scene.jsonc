// Migrated from upgrade-stale-rule-skip.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "upgrade-stale-rule-skip",
  "description": "F-022: pinch silently ignores skip entries that match no registered rule",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "workspace.json",
        "content": "{\n  \"lint\": {\n    \"skip\": [\n      \"starter-v0/agents/missing-boundaries\",\n      \"old-pack-v0/long-since-removed-rule\",\n      \"pack-renamed/this-id-is-stale-after-upgrade\"\n    ]\n  }\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-pinch",
      "name": "pinch run with mix of valid + stale skip entries",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "rulesDisabledByConfig": 1
        }
      }
    }
  ]
}
