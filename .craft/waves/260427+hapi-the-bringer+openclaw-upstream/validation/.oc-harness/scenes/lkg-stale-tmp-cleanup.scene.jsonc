// Migrated from lkg-stale-tmp-cleanup.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-stale-tmp-cleanup",
  "description": "stale .lkg.tmp file from prior crash does not break promote",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{ \"version\": \"0.1.0\" }\n"
      },
      {
        "path": "gateway.jsonc.lkg.tmp-12345-abc123",
        "content": "{ \"stale\": \"from-crashed-write\" }\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "promote despite stale tmp file",
      "verb": "promote",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "assert-file",
      "name": ".lkg companion exists (real one was written)",
      "path": "gateway.jsonc.lkg",
      "check": {
        "exists": true
      }
    },
    {
      "type": "run-cage",
      "name": "subsequent status still works (manifest walker tolerates stale tmp)",
      "verb": "status",
      "expect": {
        "exitCode": 0
      }
    }
  ]
}
