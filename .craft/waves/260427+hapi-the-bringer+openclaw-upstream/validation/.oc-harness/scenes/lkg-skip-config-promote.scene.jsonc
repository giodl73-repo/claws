// Migrated from lkg-skip-config-promote.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-skip-config-promote",
  "description": "F-021: cage promote ignores lkg.skipPaths (status honors it)",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{ \"version\": \"0.1.0\" }\n"
      },
      {
        "path": "sessions/session-abc.jsonl",
        "content": "{\"event\":\"start\",\"ts\":\"2026-05-05T10:00:00Z\"}\n{\"event\":\"end\",\"ts\":\"2026-05-05T10:00:01Z\"}\n"
      },
      {
        "path": "workspace.json",
        "content": "{\n  \"lkg\": { \"skipPaths\": [\"sessions/*\"] }\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "promote with skipPaths sessions/* set",
      "verb": "promote",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "assert-file",
      "name": "F-021: session log WAS promoted despite lkg.skipPaths (asymmetry vs status)",
      "path": "sessions/session-abc.jsonl.lkg",
      "check": {
        "exists": true
      }
    },
    {
      "type": "assert-file",
      "name": "gateway.jsonc WAS promoted (not in skip)",
      "path": "gateway.jsonc.lkg",
      "check": {
        "exists": true
      }
    },
    {
      "type": "run-cage",
      "name": "status reports the session log as skipped (not orphan, not observed)",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "skippedByConfig": {
            "atLeast": 1
          }
        }
      }
    }
  ]
}
