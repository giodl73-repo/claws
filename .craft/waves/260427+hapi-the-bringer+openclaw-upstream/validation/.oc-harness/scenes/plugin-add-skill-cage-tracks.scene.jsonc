// Migrated from plugin-add-skill-cage-tracks.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "plugin-add-skill-cage-tracks",
  "description": "add new skill mid-flight → cage status picks it up automatically",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "baseline status (no skills yet)",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "tracked": 1
        }
      }
    },
    {
      "type": "edit-file",
      "name": "operator adds a new skill",
      "path": "skills/get-weather/SKILL.md",
      "op": "set",
      "content": "---\nname: get-weather\ndescription: fetches current weather\ntier: T1\n---\n\n# get-weather\n\nFetches current weather for a location.\n"
    },
    {
      "type": "run-cage",
      "name": "cage status picks up the new skill on next walk",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "tracked": {
            "atLeast": 2
          }
        }
      }
    },
    {
      "type": "run-cage",
      "name": "observations include the new SKILL.md",
      "verb": "list-trackers",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "entries.length": {
            "atLeast": 2
          }
        }
      }
    }
  ]
}
