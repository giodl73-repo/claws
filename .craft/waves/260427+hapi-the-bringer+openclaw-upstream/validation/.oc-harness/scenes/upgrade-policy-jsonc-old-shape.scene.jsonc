// Migrated from upgrade-policy-jsonc-old-shape.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "upgrade-policy-jsonc-old-shape",
  "description": "older policy.jsonc shape (missing newer fields) → check runs gracefully",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "TOOLS.md",
        "content": "# Tools\n\n## Tools\n\n### t # R1, READ\nA tool.\n"
      },
      {
        "path": "policy.jsonc",
        "content": "{\n  \"version\": \"0.0.5\",\n  \"tools\": [\n    { \"id\": \"t\", \"risk\": 1, \"caps\": [\"READ\"], \"sensitivity\": \"public\" }\n  ],\n  \"denyRules\": []\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-policy",
      "name": "policy check on old-shape policy.jsonc",
      "verb": "check",
      "expect": {
        "exitCode": {
          "oneOf": [
            0,
            1,
            2
          ]
        }
      }
    }
  ]
}
