// Migrated from lkg-label-immutability.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-label-immutability",
  "description": "second promote --label v1 (same name) is rejected",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{ \"version\": \"0.1.0\" }"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "first promote --label v1 succeeds",
      "verb": "promote",
      "label": "v1",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "edit-file",
      "name": "mutate gateway.jsonc",
      "path": "gateway.jsonc",
      "op": "set",
      "content": "{ \"version\": \"0.1.0\", \"note\": \"different bytes\" }"
    },
    {
      "type": "run-cage",
      "name": "second promote --label v1 rejected as duplicate",
      "verb": "promote",
      "label": "v1",
      "expect": {
        "exitCode": 1,
        "errCode": "LKG_LABEL_DUPLICATE"
      }
    }
  ]
}
