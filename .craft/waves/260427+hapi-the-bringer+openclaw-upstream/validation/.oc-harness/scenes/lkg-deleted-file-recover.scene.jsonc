// Migrated from lkg-deleted-file-recover.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-deleted-file-recover",
  "description": "status flags deleted file as orphan; rollback restores it",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{\n  \"version\": \"0.1.0\",\n  \"plugins\": { \"entries\": { \"p\": { \"endpoint\": \"https://example.com\" } } }\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "promote captures baseline with label v1",
      "verb": "promote",
      "label": "v1",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "edit-file",
      "name": "delete gateway.jsonc",
      "path": "gateway.jsonc",
      "op": "delete"
    },
    {
      "type": "run-cage",
      "name": "status flags deleted gateway.jsonc as orphan (exit 1, ok false)",
      "verb": "status",
      "expect": {
        "exitCode": 1,
        "ok": false,
        "parsed": {
          "orphanCount": 1,
          "orphans[0].relPath": "gateway.jsonc",
          "byOutcome.orphan": 1,
          "byOutcome.recovered": 0
        }
      }
    },
    {
      "type": "run-cage",
      "name": "rollback restores deleted file from label v1",
      "verb": "rollback",
      "label": "v1",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "assert-file",
      "name": "gateway.jsonc back on disk with baseline content",
      "path": "gateway.jsonc",
      "check": {
        "exists": true,
        "contains": "\"version\": \"0.1.0\""
      }
    }
  ]
}
