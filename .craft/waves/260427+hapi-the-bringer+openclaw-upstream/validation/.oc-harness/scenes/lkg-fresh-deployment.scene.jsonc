// Migrated from lkg-fresh-deployment.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-fresh-deployment",
  "description": "fresh workspace, first cage status emits no error",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "first status on a workspace with no LKG state",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "tracked": {
            "atLeast": 1
          }
        }
      }
    },
    {
      "type": "assert-file",
      "name": ".openclaw/lkg-health.json gets created during walk",
      "path": ".openclaw/lkg-health.json",
      "check": {
        "exists": true
      }
    }
  ]
}
