// Migrated from plugin-iterative-policy-build.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "plugin-iterative-policy-build",
  "description": "TOOLS.md grows; policy generate/check loop catches drift",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- read-only by default\n"
      },
      {
        "path": "TOOLS.md",
        "content": "# Tools\n\n## Tools\n\n### get-info # R1, READ\nReads workspace metadata.\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-policy",
      "name": "generate policy.jsonc from TOOLS.md (v1)",
      "verb": "generate",
      "out": "policy.jsonc",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "tools": 1
        }
      }
    },
    {
      "type": "run-policy",
      "name": "policy check passes — generated state matches TOOLS.md",
      "verb": "check",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "drift.drifted": false
        }
      }
    },
    {
      "type": "edit-file",
      "name": "operator adds a second tool to TOOLS.md (forgets to regenerate)",
      "path": "TOOLS.md",
      "op": "set",
      "content": "# Tools\n\n## Tools\n\n### get-info # R1, READ\nReads workspace metadata.\n\n### post-message # R3, COMMUNICATE, sensitivity:internal\nSends a message to a configured channel.\n"
    },
    {
      "type": "run-policy",
      "name": "policy check now reports DRIFT",
      "verb": "check",
      "expect": {
        "exitCode": 1,
        "parsed": {
          "drift.drifted": true
        }
      }
    },
    {
      "type": "run-policy",
      "name": "operator regenerates policy.jsonc",
      "verb": "generate",
      "out": "policy.jsonc",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "tools": 2
        }
      }
    },
    {
      "type": "run-policy",
      "name": "policy check back in sync",
      "verb": "check",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "drift.drifted": false
        }
      }
    }
  ]
}
