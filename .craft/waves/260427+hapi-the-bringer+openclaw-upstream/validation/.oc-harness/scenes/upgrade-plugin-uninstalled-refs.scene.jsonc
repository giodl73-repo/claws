// Migrated from upgrade-plugin-uninstalled-refs.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "upgrade-plugin-uninstalled-refs",
  "description": "AGENTS.md mentions removed plugin's tools; pinch silent (rule opportunity)",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n\n## Boundaries\n\n- never invoke removed-plugin/dangerous-thing without confirmation\n- prefer removed-plugin/safe-thing for routine ops\n\n## Notes\n\nThe removed-plugin tools are deprecated; will be removed in v2.\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{\n  \"version\": \"0.1.0\",\n  \"plugins\": { \"entries\": {} }\n}\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-pinch",
      "name": "pinch run on workspace with stale tool refs in AGENTS.md",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "rulesRun": {
            "atLeast": 20
          }
        }
      }
    },
    {
      "type": "assert-file",
      "name": "AGENTS.md still mentions the removed plugin (no auto-fix)",
      "path": "AGENTS.md",
      "check": {
        "contains": "removed-plugin/dangerous-thing"
      }
    }
  ]
}
