// Migrated from lkg-empty-promote-noop.scenario.mjs. Regenerate via:
// node tools/oc-harness/scripts/migrate-mjs-scenarios.mjs <in> <out>
{
  "slug": "lkg-empty-promote-noop",
  "description": "idempotent promote — second call with same bytes is valid not promoted",
  "extensions": [
    "substrate-beats"
  ],
  "setup": {
    "files": [
      {
        "path": "AGENTS.md",
        "content": "# Agent\n## Boundaries\n- none\n"
      },
      {
        "path": "gateway.jsonc",
        "content": "{ \"version\": \"0.1.0\" }\n"
      }
    ]
  },
  "beats": [
    {
      "type": "run-cage",
      "name": "first promote (no label)",
      "verb": "promote",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "promoted": {
            "atLeast": 1
          }
        }
      }
    },
    {
      "type": "run-cage",
      "name": "second promote with no changes — still ok",
      "verb": "promote",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    },
    {
      "type": "run-cage",
      "name": "status outcomes are valid (not re-promoted)",
      "verb": "status",
      "expect": {
        "exitCode": 0,
        "parsed": {
          "byOutcome.valid": {
            "atLeast": 2
          },
          "byOutcome.promoted": 0
        }
      }
    },
    {
      "type": "run-cage",
      "name": "add a label without byte changes — should still pin atomically",
      "verb": "promote",
      "label": "pre-upgrade",
      "expect": {
        "exitCode": 0,
        "ok": true,
        "parsed": {
          "label": "pre-upgrade"
        }
      }
    },
    {
      "type": "run-cage",
      "name": "rollback to that label restores nothing visibly (bytes unchanged)",
      "verb": "rollback",
      "label": "pre-upgrade",
      "expect": {
        "exitCode": 0,
        "ok": true
      }
    }
  ]
}
