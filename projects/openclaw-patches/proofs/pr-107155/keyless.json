{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "none" }
  },
  "plugins": {
    "allow": ["workiq-code-mode", "tools-code-mode", "webiq", "diagnostics-otel"],
    "load": {
      "paths": [
        "/tmp/openclaw-pr107155-plugins/workiq-code-mode",
        "/tmp/openclaw-pr107155-plugins/tools-code-mode",
        "/tmp/openclaw-pr107155-plugins/webiq"
      ]
    },
    "entries": {
      "webiq": {
        "enabled": true,
        "config": { "webSearch": { "omitAuth": true } }
      },
      "workiq-code-mode": { "enabled": true },
      "tools-code-mode": { "enabled": true },
      "diagnostics-otel": { "enabled": true }
    }
  },
  "tools": {
    "web": {
      "search": { "enabled": true, "provider": "webiq" }
    }
  }
}
