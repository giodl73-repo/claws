{
  "name": "@bic/openclaw-lkg",
  "version": "0.1.0",
  "description": "Last-known-good (LKG) tracker — generalized factor-out of openclaw-core's config-LKG mechanism (issue #70528, commit af56926e2fc4). Pluggable per-file recovery: promote-on-validate, restore-on-invalid, audit, recovery notice.",
  "keywords": [
    "bic",
    "last-known-good",
    "lkg",
    "openclaw",
    "recovery",
    "tracker"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inmemory": {
      "types": "./dist/inmemory.d.ts",
      "import": "./dist/inmemory.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bic/v2-prototype": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@bic/v2-prototype": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
