{
  "name": "@bic/openclaw-snap",
  "version": "0.1.0",
  "description": "OpenClaw snapshot registry — SnapshotStore interface + in-memory/filesystem reference impls + HTTP server (9 endpoints).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-handlers": {
      "types": "./dist/cli-handlers/index.d.ts",
      "import": "./dist/cli-handlers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@bic/openclaw-guardrails": "^0.1.0",
    "@bic/openclaw-workspace": "^0.1.0"
  },
  "devDependencies": {
    "@bic/openclaw-guardrails": "*",
    "@bic/openclaw-policy": "*",
    "@bic/openclaw-workspace": "*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "openclaw",
    "snap",
    "snapshot",
    "registry",
    "http",
    "bic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://microsoft.ghe.com/bic/claws.git",
    "directory": "claws-sdk/packages/snap"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.microsoft.ghe.com/"
  },
  "author": "",
  "bugs": {
    "url": "https://microsoft.ghe.com/bic/claws/issues"
  },
  "homepage": "https://microsoft.ghe.com/bic/claws#readme"
}
