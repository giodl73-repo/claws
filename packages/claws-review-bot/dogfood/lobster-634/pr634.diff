+# Tests write a synthetic index.html into a tempdir, point the router at
+# it, then assert on the served HTML.
+tempfile = "3"
 # Ephemeral RSA-2048 keypair generation for auth/ test fixtures.
 # Avoids checking in static PEM / JWK files (SDL concern).
 rsa = { version = "0.9", features = ["pem"] }
diff --git a/src/lobster_runtime/dev-start.sh b/src/lobster_runtime/dev-start.sh
index 83602c49..139ad5fc 100755
--- a/src/lobster_runtime/dev-start.sh
+++ b/src/lobster_runtime/dev-start.sh
@@ -81,11 +81,29 @@ export STATIC_DIR="$DIST_DIR"
 export TLS_CERT_PATH="$CERT_DIR/tls.crt"
 export TLS_KEY_PATH="$CERT_DIR/tls.key"
 
+# MSAL auth is OFF by default for local dev -- the runtime leaves the
+# index.html placeholders untouched and the bundle's IIFE skips MSAL
+# init. To opt in, export both vars before running this script:
+#
+#   export LOBSTER_MSAL_CLIENT_ID=044097e5-1695-46a7-9a77-433a4c507c8c
+#   export LOBSTER_MSAL_AUTHORITY=https://login.microsoftonline.com/organizations
+#   ./dev-start.sh
+#
+# The TEST-Lobster app registration must have https://localhost:8443/auth/callback
+# in its redirect-URI list (registered via the AAD-FirstPartyApps repo
+# or via the Portal for non-prod app regs).
+if [[ -n "${LOBSTER_MSAL_CLIENT_ID:-}" ]]; then
+    echo -e "\033[36mMSAL auth: ENABLED (clientId=$LOBSTER_MSAL_CLIENT_ID)\033[0m"
+else
+    echo -e "\033[33mMSAL auth: OFF (set LOBSTER_MSAL_CLIENT_ID to opt in)\033[0m"
+fi
+
 echo ""
 echo -e "\033[32mApplication available at: https://localhost:8443\033[0m"
 echo "Liveness:                 https://localhost:8443/health/live"
 echo "Readiness:                https://localhost:8443/health/ready"
 echo "Web UI:                   https://localhost:8443/web"
+echo "Auth callback:            https://localhost:8443/auth/callback"
 echo "Security:                 HTTPS enforced (self-signed cert for dev)"
 echo ""
 echo -e "\033[33mPress Ctrl+C to stop.\033[0m"
