+/**
+ * Right-aligned signed-in identity indicator in the TopNav.
+ *
+ * MSAL is initialized at boot from `__LOBSTER_RUNTIME_CONFIG__.msal` (set
+ * by the runtime when LOBSTER_MSAL_CLIENT_ID is configured).  After init,
+ * the MSAL instance is reachable via `_getMsalInstance()`.  We read it to
+ * decide what to render:
+ *
+ *   - MSAL not wired (local dev default) => render nothing.
+ *   - MSAL wired, no account             => render nothing.  The pre-sign-in
+ *     "Sign in" affordance is already handled by the `CapabilityBanner`
+ *     (yellow strip with "Sign in to use Lobster" on all non-landing routes)
+ *     and the landing page's inline "Sign in to use Lobster" button.
+ *     Duplicating a second "Sign in" button in the TopNav would be
+ *     confusing and redundant.
+ *   - MSAL wired, account present        => show the account's display name
+ *     (read-only for now; sign-out is a follow-up).
+ *
+ * MSAL's `handleRedirectPromise` resolves asynchronously at boot, so the
+ * account snapshot taken at first paint may be empty even when AAD just
+ * sent the user back signed-in.  A short polling effect catches that
+ * transition without dragging in MSAL's full event-callback API.
+ */
+function SignInWidget(): ReactNode {
+  const styles = useNavStyles();
+  const [account, setAccount] = useState<MsalAccountInfo | null>(() => {
+    const app = _getMsalInstance();
+    return app?.getActiveAccount() ?? app?.getAllAccounts()[0] ?? null;
+  });
+
+  useEffect(() => {
+    // Poll briefly so the widget catches the post-redirect account
+    // appearing once handleRedirectPromise resolves.  Polling stops
+    // after 5s -- handleRedirectPromise typically resolves within
+    // hundreds of ms; if it hasn't by then, MSAL hit a transient
+    // failure that needs a manual sign-in click anyway.
+    const start = Date.now();
+    const id = window.setInterval(() => {
+      const app = _getMsalInstance();
+      const next = app?.getActiveAccount() ?? app?.getAllAccounts()[0] ?? null;
+      // Only update state when the account actually changes to avoid
+      // unnecessary re-renders while polling.  Compare by localAccountId
+      // (stable across token refreshes) rather than object reference.
+      setAccount((prev) => {
+        const prevId = prev?.localAccountId ?? null;
+        const nextId = next?.localAccountId ?? null;
+        return prevId === nextId ? prev : next;
+      });
+      if (Date.now() - start > 5000 || next !== null) {
+        window.clearInterval(id);
+      }
+    }, 250);
+    return () => window.clearInterval(id);
+  }, []);
+
+  // No MSAL instance or no account yet => render nothing.
+  // The CapabilityBanner already handles the "Sign in" CTA for
+  // auth-required state on all non-landing routes; we only surface
+  // the identity indicator once the user has signed in.
+  if (account === null) {
+    return null;
+  }
+
+  return (
+    <span
+      data-testid="lobster-top-nav-account"
+      style={{ marginLeft: 'auto' }}
+      className={styles.link}
+      aria-label={`Signed in as ${account.name ?? account.username}`}
+    >
+      {account.name ?? account.username}
+    </span>
+  );
+}
+
 function NavShell({ children }: { readonly children: ReactNode }): ReactNode {
   return (
     <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh' }}>
