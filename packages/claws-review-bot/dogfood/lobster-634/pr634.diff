+# `ServiceExt::oneshot` for invoking ServeDir as a one-shot service from
+# the /web catch-all handler (substitution-vs-static dispatch). Already
+# transitively present via tower-http; declared explicitly here so the
+# `oneshot` method is reachable from the lib crate.
+tower = { version = "0.5", features = ["util"] }
 
 # JWT auth (auth/ module).
 # `jsonwebtoken` is the de-facto Rust JWT crate; pinning Algorithm::RS256
@@ -99,6 +104,10 @@ azure_core = { version = "0.31", default-features = false, features = ["reqwest"
 tower = { version = "0.5", features = ["util"] }
 http-body-util = "0.1"
 hyper = "1"
