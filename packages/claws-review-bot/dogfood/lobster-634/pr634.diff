index 00000000..6c9e2cf9
--- /dev/null
+++ b/src/lobster_runtime/src/routes/web.rs
@@ -0,0 +1,190 @@
+//! Handlers for the `/web` SPA root and the `/auth/callback` OAuth bouncer.
+//!
+//! `/web/` and `/web/index.html` are served by [`serve_index`], which reads
+//! `index.html` off disk per request and substitutes the MSAL placeholders
+//! (`__LOBSTER_MSAL_CLIENT_ID__`, `__LOBSTER_MSAL_AUTHORITY__`) when the
+//! runtime is configured with an MSAL client ID. Substitution at request
+//! time means the same Docker image promotes Dev -> Test -> Prod with
+//! different env values, instead of baking auth identifiers into the image.
+//!
+//! `/auth/callback` is the AAD redirect URI registered against the Lobster
+//! 1P apps. AAD's response (auth code + state) lands in the URL fragment,
+//! which the browser keeps client-side; we serve a minimal HTML bouncer
+//! that calls `window.location.replace('/web/' + window.location.hash)` so
+//! the lobster_web bundle's `handleRedirectPromise()` can consume the
+//! fragment and complete sign-in.
+
+use axum::body::Body;
+use axum::extract::{Request, State};
+use axum::http::{header, StatusCode};
+use axum::response::{Html, IntoResponse, Response};
+use std::sync::Arc;
+use tower::ServiceExt;
+use tower_http::services::ServeDir;
+use tracing::{error, warn};
+
+use crate::config::MsalConfig;
+
+/// Shared state passed to the `/web` and `/auth/callback` handlers.
+#[derive(Clone)]
+pub struct WebState {
+    /// Filesystem path to the directory holding `index.html` + assets.
+    pub static_dir: Arc<str>,
+    /// MSAL configuration to inject into `index.html`. `None` = leave the
+    /// placeholders untouched (local-dev default).
+    pub msal: Option<MsalConfig>,
+}
+
+/// Serve `index.html` with MSAL placeholders substituted in when configured.
+///
+/// `__LOBSTER_MSAL_CLIENT_ID__` and `__LOBSTER_MSAL_AUTHORITY__` are the two
+/// placeholders the bundle's pre-bundle script looks for (see
+/// `src/lobster_web/index.html`). When `state.msal` is `None`, the
+/// placeholders pass through verbatim and the bundle's IIFE detects them
+/// (`clientId.indexOf("__LOBSTER_") === 0`) and skips MSAL init.
+pub async fn serve_index(State(state): State<WebState>) -> Response {
+    let path = format!("{}/index.html", state.static_dir);
+    match tokio::fs::read_to_string(&path).await {
+        Ok(html) => {
+            let html = match &state.msal {
+                Some(cfg) => html
+                    .replace("__LOBSTER_MSAL_CLIENT_ID__", &cfg.client_id)
+                    .replace("__LOBSTER_MSAL_AUTHORITY__", &cfg.authority),
+                None => html,
+            };
+            Html(html).into_response()
+        }
+        Err(e) => {
+            error!(path = %path, error = %e, "Failed to read index.html for /web/");
+            (StatusCode::INTERNAL_SERVER_ERROR, "Unable to serve page").into_response()
+        }
+    }
+}
+
+/// Catch-all handler for `/web/{*rest}` -- dispatches to [`serve_index`]
+/// when `rest` is empty or `index.html`, otherwise delegates to `ServeDir`
+/// for the static asset.
+///
+/// Mixing `route("/web")` and `nest_service("/web", ServeDir)` panics in
+/// axum 0.8 ("Insertion failed due to conflict"), and a nested router
+/// with `route("/") + fallback_service(ServeDir)` 404s on the prefix root
+/// ("/web/" hits the fallback rather than the route). A single catch-all
+/// handler avoids both pitfalls -- we own the dispatch.
+pub async fn serve_web_path(
+    State(state): State<WebState>,
+    axum::extract::Path(rest): axum::extract::Path<String>,
+    req: Request<Body>,
+) -> Response {
+    if rest.is_empty() || rest == "index.html" {
+        return serve_index(State(state)).await;
+    }
+    serve_static_asset(&state.static_dir, rest, req).await
+}
+
+/// Handler for `GET /web/` and `GET /web` -- the catch-all glob doesn't
+/// match the bare prefix root in axum, so we register this separately.
+pub async fn serve_web_root(State(state): State<WebState>) -> Response {
+    serve_index(State(state)).await
+}
+
+/// Forward `/web/{rest}` to `ServeDir` rooted at `static_dir`. Building the
+/// service inline per request keeps the type plumbing simple -- the dir
+/// path is small and `ServeDir` construction is cheap.
+async fn serve_static_asset(static_dir: &str, rest: String, req: Request<Body>) -> Response {
+    // Rewrite the request path: `ServeDir` maps the request URI directly to
+    // a file under its root, so it needs `/rest`, not `/web/rest`.
+    let mut parts = req.into_parts().0;
+    let new_uri = match format!("/{rest}").parse() {
+        Ok(uri) => uri,
+        Err(e) => {
+            warn!(rest = %rest, error = %e, "Invalid /web/ asset path");
+            return (StatusCode::BAD_REQUEST, "invalid path").into_response();
+        }
+    };
+    parts.uri = new_uri;
+    let inner_req = Request::from_parts(parts, Body::empty());
+    let svc = ServeDir::new(static_dir);
+    match svc.oneshot(inner_req).await {
+        Ok(asset_resp) => asset_resp.map(Body::new),
+        Err(_unreachable) => {
+            // `tower_http::services::ServeDir`'s error type is `std::convert::Infallible`.
+            (StatusCode::INTERNAL_SERVER_ERROR, "Unable to serve page").into_response()
+        }
+    }
+}
+
+/// AAD OAuth callback bouncer.
+///
+/// AAD redirects here with the response in the URL fragment
+/// (`#code=...&state=...`). Browsers don't send fragments to the server, so
+/// the Rust runtime can't read them -- we serve a minimal HTML page that
+/// redirects to `/web/`, and the browser carries the fragment across to the
+/// new URL where the `lobster_web` bundle's MSAL `handleRedirectPromise()`
+/// reads and consumes it.
+///
+/// Uses `window.location.replace` rather than `assign` so the callback URL
+/// doesn't end up in the browser's back-button history.
+pub async fn auth_callback() -> impl IntoResponse {
+    // Restrictive CSP: default-src 'none' blocks everything; script-src
+    // 'unsafe-inline' allows only the inline redirect script (no external
+    // scripts). style-src 'unsafe-inline' allows the <noscript> fallback
+    // link styling. No connect-src, img-src, etc. -- the page loads
+    // nothing external.
+    let csp = "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'";
+    (
+        [(header::CONTENT_SECURITY_POLICY, csp)],
+        Html(
+        "<!doctype html>\n\
+         <html lang=\"en\">\n\
+         <head>\n\
+         <meta charset=\"utf-8\">\n\
+         <title>Signing in...</title>\n\
+         <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\
+         </head>\n\
+         <body>\n\
+         <p>Signing in -- one moment.</p>\n\
+         <script>\n\
+         (function () {\n\
+           var hash = window.location.hash || '';\n\
+           var search = window.location.search || '';\n\
+           // Carry both fragment (response_mode=fragment, MSAL default) and\n\
+           // query (response_mode=query) variants across to /web/ so MSAL\n\
+           // can pick whichever one AAD used. handleRedirectPromise reads\n\
+           // location.hash; query params are preserved for diagnostics.\n\
+           window.location.replace('/web/' + search + hash);\n\
+         })();\n\
+         </script>\n\
+         <noscript>JavaScript is required to complete sign-in. <a href=\"/web/\">Continue</a>.</noscript>\n\
+         </body>\n\
+         </html>\n"),
+    )
+}
+
+/// Diagnostic helper: warn at startup when MSAL is configured but the
+/// `index.html` file is missing or doesn't contain the expected
+/// placeholders. Catches the common misconfiguration where the env vars
+/// got set but `build-static.sh` wasn't run.
+pub fn warn_if_msal_template_missing(state: &WebState) {
+    let Some(_msal) = &state.msal else {
+        return;
+    };
+    let path = format!("{}/index.html", state.static_dir);
+    match std::fs::read_to_string(&path) {
+        Ok(html) => {
+            if !html.contains("__LOBSTER_MSAL_CLIENT_ID__") {
+                warn!(
+                    path = %path,
+                    "MSAL configured but index.html has no __LOBSTER_MSAL_CLIENT_ID__ placeholder \
+                     -- substitution will silently no-op and the bundle won't initialize MSAL"
+                );
+            }
+        }
+        Err(e) => {
+            warn!(
+                path = %path,
+                error = %e,
+                "MSAL configured but index.html could not be read at startup"
+            );
+        }
+    }
+}
