{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "ghePat": {
      "value": "REPLACE_WITH_GHE_PAT_FROM_gh_auth_token"
    },
    "containerImage": {
      "value": "clawsreviewbotacr.azurecr.io/claws-review-bot:latest"
    },
    "watchRepos": {
      "value": "bic/lobster"
    },
    "pollIntervalMinutes": {
      "value": 10
    },
    "postComments": {
      "value": false
    },
    "aoaiResourceGroup": {
      "value": "rg-clawcode"
    },
    "aoaiAccountName": {
      "value": "clawcode-aoai"
    },
    "aoaiDeploymentName": {
      "value": "reviewer-gpt-5.5"
    },
    "aoaiDeploymentNameReeval": {
      "value": "reviewer-gpt-5.4-mini"
    },
    "aoaiReasoningEffort": {
      "value": "high"
    },
    "aoaiVerbosity": {
      "value": "medium"
    },
    "aoaiMaxCompletionTokens": {
      "value": 32000
    },
    "acrAccountName": {
      "value": "clawsreviewbotacr"
    }
  }
}
