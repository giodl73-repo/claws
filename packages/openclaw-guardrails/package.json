{
  "name": "@bic/openclaw-guardrails",
  "version": "0.1.0",
  "description": "OpenClaw governance package — GuardrailProvider + FileIngestProvider interfaces plus six runtime subpaths (audit, approvals, budget, identity, siem, secrets).",
  "keywords": [
    "approvals",
    "audit",
    "bic",
    "budget",
    "governance",
    "guardrail",
    "identity",
    "openclaw",
    "secrets",
    "siem"
  ],
  "homepage": "https://microsoft.ghe.com/bic/claws#readme",
  "bugs": {
    "url": "https://microsoft.ghe.com/bic/claws/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://microsoft.ghe.com/bic/claws.git",
    "directory": "claws-sdk/packages/guardrails"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "import": "./dist/approvals/index.js"
    },
    "./budget": {
      "types": "./dist/budget/index.d.ts",
      "import": "./dist/budget/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./siem": {
      "types": "./dist/siem/index.d.ts",
      "import": "./dist/siem/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js"
    },
    "./handle-binding": {
      "types": "./dist/handle-binding/index.d.ts",
      "import": "./dist/handle-binding/index.js"
    },
    "./openclaw-adapter": {
      "types": "./dist/openclaw-adapter.d.ts",
      "import": "./dist/openclaw-adapter.js"
    },
    "./policy-runtime": {
      "types": "./dist/policy-runtime/index.d.ts",
      "import": "./dist/policy-runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.microsoft.ghe.com/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@bic/openclaw-workspace": "^0.1.0",
    "@bic/v2-prototype": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
