{
  "name": "@bic/openclaw-policy",
  "version": "0.2.0",
  "description": "OpenClaw policy generator + /runtime ABI for generated gateway plugins. Consolidates compile, emit, governance-ast, and runtime helpers into one package.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./cli-handlers": {
      "types": "./dist/cli-handlers/index.d.ts",
      "import": "./dist/cli-handlers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@bic/openclaw-workspace": "^0.1.0",
    "@bic/openclaw-guardrails": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@bic/openclaw-guardrails": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "openclaw",
    "policy",
    "gateway",
    "generator",
    "governance",
    "bic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://microsoft.ghe.com/bic/claws.git",
    "directory": "claws-sdk/packages/policy"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.microsoft.ghe.com/"
  },
  "bugs": {
    "url": "https://microsoft.ghe.com/bic/claws/issues"
  },
  "homepage": "https://microsoft.ghe.com/bic/claws#readme"
}
