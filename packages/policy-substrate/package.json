{
  "name": "@bic/policy-substrate",
  "version": "0.1.0",
  "description": "OpenClaw policy substrate: PolicyIR types contract (upstream PR-1) + reference markdown extractor pack consuming the oc-paths universal substrate. Sister to oc-paths-substrate / lkg-recovery-substrate.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openclaw-policy": "./bin/openclaw-policy.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk/policy/index.d.ts",
      "import": "./dist/plugin-sdk/policy/index.js"
    },
    "./extractors-starter": {
      "types": "./dist/extensions/policy-from-md-starter/index.d.ts",
      "import": "./dist/extensions/policy-from-md-starter/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "bin"],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bic/oc-paths-substrate": "*",
    "@bic/lkg-recovery-substrate": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  }
}
