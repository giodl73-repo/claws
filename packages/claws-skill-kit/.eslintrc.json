{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@bic/claws-cli", "@bic/claws-cli/*"],
            "message": "@bic/claws-skill-kit must not depend on claws-cli. Use local types or import type from claws-sdk."
          },
          {
            "group": ["@craftworks/claws-base-cli", "@craftworks/claws-base-cli/*"],
            "message": "@bic/claws-skill-kit must not depend on claws-base-cli. Use local types or import type from claws-sdk."
          },
          {
            "group": ["@craftworks/craftworks-sdk", "@craftworks/craftworks-sdk/*"],
            "message": "@bic/claws-skill-kit must not depend on craftworks-sdk. This package is standalone."
          },
          {
            "group": ["@craftworks/shared-cli", "@craftworks/shared-cli/*"],
            "message": "@bic/claws-skill-kit must not depend on shared-cli. This package is standalone."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "plugins": ["@typescript-eslint"],
      "rules": {
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "disallowTypeAnnotations": true
          }
        ]
      }
    }
  ]
}
