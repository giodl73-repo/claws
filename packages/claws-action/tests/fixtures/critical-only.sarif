{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "claws",
          "version": "0.1.0",
          "informationUri": "https://claws.dev",
          "rules": [
            {
              "id": "G-PERM-001",
              "name": "G-PERM-001",
              "shortDescription": {
                "text": "Governance rule G-PERM-001"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "G-PERM-001",
          "level": "error",
          "message": {
            "text": "Tool execute_command has no approval gate"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "TOOLS.md"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
