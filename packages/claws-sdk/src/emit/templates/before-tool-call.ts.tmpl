import type { GovernanceHost } from '@openclaw/governance';

/**
 * Pre-computed risk map — O(1) lookup.
 */
const RISK_MAP: ReadonlyMap<string, number> = new Map<string, number>({{riskMapEntries}});

/**
 * before_tool_call handler.
 * Evaluates governance policy before every tool invocation.
 * Uses AbortSignal.timeout for timeout enforcement.
 * R5 deny-on-error: any error with an R5 tool results in denial.
 */
export async function beforeToolCall(
  host: GovernanceHost,
  toolName: string | null | undefined,
  context: Record<string, unknown>,
  hookTimeoutMs: number = {{hookTimeoutMs}},
): Promise<{ allowed: boolean; blockReason: string | null }> {
  if (toolName == null) {
    try { host.emitAuditEvent({ event: 'null-tool-deny', hook: 'before_tool_call' }); } catch { /* fire-and-forget */ }
    return { allowed: false, blockReason: 'Tool name is null or undefined' };
  }

  const riskLevel = RISK_MAP.get(toolName) ?? 5;

  try {
    const signal = AbortSignal.timeout(hookTimeoutMs);
    const result = await host.evaluatePolicy(toolName, context, signal);
    return { allowed: result.allowed, blockReason: result.blockReason };
  } catch (err: unknown) {
    const isTimeout = err instanceof DOMException && err.name === 'AbortError';
    const errorType = isTimeout ? 'timeout' : 'error';

    try {
      host.emitAuditEvent({ event: 'before-tool-call-error', toolName, errorType, riskLevel });
    } catch { /* fire-and-forget */ }

    // R5 deny-on-error — any error with an R5 tool means deny
    if (riskLevel >= 5) {
      return { allowed: false, blockReason: `Governance ${errorType} — R5 fail-closed` };
    }
    // R3-R4: fail-closed by default
    if (riskLevel >= 3) {
      return { allowed: false, blockReason: `Governance ${errorType} — R${riskLevel} fail-closed` };
    }
    // R1-R2: fail-open
    return { allowed: true, blockReason: null };
  }
}
