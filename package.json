{
  "name": "standalone-claw-cli-prototype",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src test",
    "prepublishOnly": "node -e \"throw new Error('Publishing is disabled for the private naming prototype.')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "clawhub-schema": "file:../clawhub-claws-pr5-clawmd-soul/packages/schema"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
