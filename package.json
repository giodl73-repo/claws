{
  "name": "claws-private-incubator",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @claws/cli-private build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "claws-dev": "node packages/cli/dist/cli.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings packages scripts",
    "proof:pack": "pnpm build && node scripts/prove-packed-cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.74.0",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@10.33.2"
}
